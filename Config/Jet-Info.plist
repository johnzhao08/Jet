<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the Info.plist Xcode generates. Lets other apps' share sheets and Files' "Open in"
     hand documents to Jet, which copies them into the open vault. -->
<plist version="1.0">
<dict>
	<!-- Vaults show up in the Files app (On My iPad > Jet). Xcode doesn't generate this one. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>net.daringfireball.markdown</string>
				<string>public.plain-text</string>
				<string>public.image</string>
				<string>public.content</string>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<!-- jet:// links from widgets: jet://capture, jet://daily, jet://new/note, jet://new/ink, jet://open?path=… -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.johnzhao.jet</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jet</string>
			</array>
		</dict>
	</array>
	<!-- Rows dragged around inside Jet's sidebar. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.johnzhao.jet.vault-item</string>
			<key>UTTypeDescription</key>
			<string>Jet Vault Item</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
